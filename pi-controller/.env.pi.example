# The defaults below already match the payment website. Copy this file to
# .env.pi only when you need to change a value or enable MQTT authentication.
MQTT_HOST=minecraft.duniapalsu.com
MQTT_PORT=1883
MQTT_TOPIC=surau/setia-eco-glades/massage-chair/1/session
# MQTT_USERNAME=
# MQTT_PASSWORD=
# The website backend owns the Shelly relay and session timer. This optional
# controller only subscribes to the session topic to render the OLED display.
